   "mcp",
   "list"
  ]
 },
 "slack": {
  "footer": "🤖 Generated with Claude Code"
 },
 "report": {
  "user": "",
  "title": "[foundry] {user} daily report",
  "channel": "",
  "thread": "",
  "kind_emoji": ":memo:",
  "sections": [
   "lines",
   "done",
   "ops",
   "release_gaps",
   "review_gaps",
   "tonight",
   "tomorrow",
   "owner"
  ],
  "exclude": {
   "repos": [],
   "channels": []
  },
  "remind_time": "09:00",
  "review_wait_hours": 24,
  "collapse_lines": 2,
  "max_replies": 10
 },
 "stale_business_days": 1,
 "schedules": [
  {
   "name": "handover",
   "cron": "0 8 * * *",
   "run": "foundry report handover"
  },
  {
   "name": "handover-refresh",
   "cron": "0 10,12,14,16,18,20 * * 1-5",
   "run": "foundry report handover (refreshes the board's handover; the board shows it, so do not paste it to the owner again)"
  },
  {
   "name": "preflight-night",
   "cron": "55 21 * * *",
   "run": "foundry preflight"
  },
  {
   "name": "preflight-morning",
   "cron": "55 7 * * *",
   "run": "foundry preflight"
  },
  {
   "name": "kaizen",
   "cron": "0 9 * * 1",
   "run": "foundry report kaizen"
  },
  {
   "name": "intake-scan",
   "cron": "15 9-19 * * 1-5",
   "run": "foundry intake scan (proposes new review requests and assigned issues as plan-mode units plus an owner card; the first run only records)"
  }
 ]
}
